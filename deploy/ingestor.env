# Ingestor configuration, loaded by `make run-ingestor` and by docker compose as the ingestor's
# env_file. Compose overrides NATS_URL to reach the `nats` container.
#
# - Each value here is the built-in default, so the file documents them. Edit to taste.
# - Variables already set in your environment win over this file, for one-off overrides:
#     BOOK_DEPTH=100 BOOK_THROTTLE_MS=0 make run-ingestor
# - Another file can be used instead: make run-ingestor INGESTOR_ENV=path/to/other.env
# - Format: KEY=VALUE, one per line, no quotes, no spaces around "=". Lines starting with "#"
#   are comments.
# - Everything is validated at startup; an invalid value stops the ingestor with an error.
#   A test checks that this file loads and lists exactly the variables the ingestor reads.

# Canonical symbols to stream, comma-separated (BASE-QUOTE, upper case).
SYMBOLS=BTC-USD

# Levels per side in each published OrderBook, 1-100.
BOOK_DEPTH=50

# Minimum interval in milliseconds between two publishes of the same book. 0 publishes every
# update.
BOOK_THROTTLE_MS=50

# NATS server. `make up` serves it on localhost:4222.
NATS_URL=nats://localhost:4222

# Kraken WebSocket API v2 endpoint (public, no API key).
KRAKEN_WS_URL=wss://ws.kraken.com/v2

# Coinbase Advanced Trade WebSocket endpoint (public, no API key).
COINBASE_WS_URL=wss://advanced-trade-ws.coinbase.com

# Listen address of the HTTP server: Prometheus /metrics and /healthz.
HTTP_ADDR=:8080

# debug, info, warn or error. Logs are JSON on stderr.
LOG_LEVEL=info
